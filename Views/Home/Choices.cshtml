@{
    ViewData["Title"] = "Choose Your Option";
}

<link rel="stylesheet" href="~/css/ChoicesStyle.css">

<div class="navbar">
    <div class="navidiv">
        <div class="logo">✈️ Lipad Cebu</div>
    </div>
</div>

<main>
    <h1 style="text-align: center; color: white; margin-bottom: 40px;">Choose Your Destination</h1>
    
    <div class="container">
        <div class="card">
            <img src="~/images/CurtainFalls.jpg" alt="Curtain Falls">
            <div class="intro">
                <h2>Curtain Falls</h2>
                <p>Explore the breathtaking Curtain Falls and experience nature's beauty.</p>
                <a href="/Booking/Booking" class="book">Book Now</a>
            </div>
        </div>

        <div class="card">
            <img src="~/images/FortSanPedro.jpg" alt="Fort San Pedro">
            <div class="intro">
                <h2>Fort San Pedro</h2>
                <p>Visit the historic Fort San Pedro and learn about Cebu's rich history.</p>
                <a href="/Booking/Booking" class="book">Book Now</a>
            </div>
        </div>

        <div class="card">
            <img src="~/images/KawasanFalls.jpg" alt="Kawasan Falls">
            <div class="intro">
                <h2>Kawasan Falls</h2>
                <p>Enjoy the stunning Kawasan Falls with crystal clear waters.</p>
                <a href="/Booking/Booking" class="book">Book Now</a>
            </div>
        </div>

        <div class="card">
            <img src="~/images/MactanShrine.jpg" alt="Mactan Shrine">
            <div class="intro">
                <h2>Mactan Shrine</h2>
                <p>Pay respects at the iconic Mactan Shrine monument.</p>
                <a href="/Booking/Booking" class="book">Book Now</a>
            </div>
        </div>

        <div class="card">
            <img src="~/images/MagellanCross.jpg" alt="Magellan's Cross">
            <div class="intro">
                <h2>Magellan's Cross</h2>
                <p>Discover the historic Magellan's Cross in downtown Cebu.</p>
                <a href="/Booking/Booking" class="book">Book Now</a>
            </div>
        </div>

        <div class="card">
            <img src="~/images/Oslob.jpg" alt="Oslob">
            <div class="intro">
                <h2>Oslob Whale Sharks</h2>
                <p>Swim with the gentle whale sharks in Oslob.</p>
                <a href="/Booking/Booking" class="book">Book Now</a>
            </div>
        </div>

        <div class="card">
            <img src="~/images/Simala.jpg" alt="Simala Sanctuary">
            <div class="intro">
                <h2>Simala Sanctuary</h2>
                <p>Visit the beautiful Simala Sanctuary and marvel at its architecture.</p>
                <a href="/Booking/Booking" class="book">Book Now</a>
            </div>
        </div>

        <div class="card">
            <img src="~/images/TempleOfLea.jpg" alt="Temple of Lea">
            <div class="intro">
                <h2>Temple of Lea</h2>
                <p>Explore the mystical Temple of Lea with its scenic views.</p>
                <a href="/Booking/Booking" class="book">Book Now</a>
            </div>
        </div>

        <div class="card">
            <img src="~/images/ToistTemple.jpg" alt="Toist Temple">
            <div class="intro">
                <h2>Toist Temple</h2>
                <p>Experience the serenity of the ancient Toist Temple.</p>
                <a href="/Booking/Booking" class="book">Book Now</a>
            </div>
        </div>
    </div>

    <div style="text-align: center; margin-top: 40px;">
        <a href="/Home/Homepage" class="book">Back to Home</a>
    </div>
</main>
