@model lipadcebu2.Models.Booking


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Confirmed</title>
    <style>

        body{
            background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url(../images/BookingBackground.jpg);
            background-repeat: no-repeat;
            background-size: cover;
    height: 100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
            } 

        body {
            font-family: Arial, sans-serif;
            background-color: #f0f4f8;
            display: flex;
            justify-content: center;
            padding: 40px 20px;
        }
        .box {
            background-color: white;
            padding: 40px;
            border-radius: 12px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            text-align: center;
        }
        .checkmark {
            font-size: 60px;
            margin-bottom: 10px;
        }
        h1 {
            color: #1a3c5e;
            margin-bottom: 5px;
        }
        p.subtitle {
            color: #888;
            font-size: 14px;
            margin-bottom: 30px;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
            text-align: left;
        }
        .detail-label {
            color: #888;
        }
        .detail-value {
            font-weight: bold;
            color: #1a3c5e;
        }
        .total-box {
            background-color: #eef4fb;
            border-radius: 8px;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            font-weight: bold;
            font-size: 16px;
            color: #1a3c5e;
        }
        .back-btn {
            display: block;
            margin-top: 25px;
            padding: 14px;
            background-color: #1a3c5e;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-size: 16px;
        }
        .back-btn:hover {
            background-color: #15304e;
        }
    </style>
</head>
<body>
    <div class="box">
        <!-- Big checkmark to show success -->
        <div class="checkmark">✅</div>
        <h1>Booking Confirmed!</h1>
        <p class="subtitle">Your booking has been saved successfully.</p>

        <!-- Show all the booking details -->
        <div class="detail-row">
            <span class="detail-label">Booking ID</span>
            <span class="detail-value">#@Model.Id</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Guest Name</span>
            <span class="detail-value">@Model.GuestName</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Email</span>
            <span class="detail-value">@Model.GuestEmail</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Phone</span>
            <span class="detail-value">@Model.PhoneNumber</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Room Type</span>
            <span class="detail-value">@Model.RoomType</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Number of Rooms</span>
            <span class="detail-value">@Model.NumberOfRooms</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Check-In</span>
            <span class="detail-value">@Model.CheckInDate</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Check-Out</span>
            <span class="detail-value">@Model.CheckOutDate</span>
        </div>

        @if (!string.IsNullOrEmpty(Model.SpecialRequests))
        {
            <div class="detail-row">
                <span class="detail-label">Special Requests</span>
                <span class="detail-value">@Model.SpecialRequests</span>
            </div>
        }

        <div class="total-box">
            <span>Total Amount</span>
            <span>₱@Model.TotalPrice.ToString("N2")</span>
        </div>

        <a href="/Home/Choices" class="back-btn">Make Another Booking</a>
    </div>
</body>
</html>
